# Строка подключения к PostgreSQL
DATABASE_URL=postgres://teamup:teamup@localhost:5432/teamup

# Адрес сайта: из него собираются ссылки для входа
APP_URL=http://localhost:3000

# Бот в Max. Токен и имя бота выдаёт платформа «MAX для партнёров» после модерации, см. docs/bots.md
MAX_BOT_TOKEN=
# Имя бота без @ (из ссылки https://max.ru/имя_бота)
MAX_BOT_NAME=
# Любая длинная случайная строка: ею Max подписывает вебхук
MAX_WEBHOOK_SECRET=

# Бот в Телеграме. Токен выдаёт @BotFather (команда /newbot), см. docs/bots.md
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (из ссылки https://t.me/имя_бота)
TELEGRAM_BOT_NAME=
# Секрет вебхука Телеграма: латинские буквы, цифры, _ и -
TELEGRAM_WEBHOOK_SECRET=
